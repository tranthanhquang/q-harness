# Local development defaults. Q-Harness does not load .env automatically.
# Load your own trusted file with: set -a; source .env; set +a
QH_DATABASE_URL=postgresql+psycopg://qharness:qharness@127.0.0.1:55432/qharness
QH_DATA_DIR=.tmp/qharness-data
QH_BIND_HOST=127.0.0.1
QH_PORT=8765
# Required only for HTTP/MCP: generate a random token of at least 32 characters.
QH_LOCAL_TOKEN=
# Required only for coding execution; never commit real credentials.
QH_MODEL=
OPENAI_API_KEY=
QH_SANDBOX_IMAGE=q-harness-sandbox:dev
# Optional: select a Project outside its workspace. Leave this commented until set.
# QH_PROJECT_ID=your-project-uuid

